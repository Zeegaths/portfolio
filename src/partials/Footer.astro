---
import { AppConfig } from '@/utils/AppConfig';

const year = new Date().getFullYear();
---

<footer class='border-t border-line bg-surface'>
  <div
    class='container-page flex flex-col items-center justify-between gap-6 py-10 sm:flex-row'
  >
    <p class='font-mono text-xs uppercase tracking-[0.16em] text-ink-muted'>
      © {year}
      {AppConfig.author}
    </p>

    <p class='flex items-center gap-1.5 text-sm text-ink-muted'>
      Built with
      <svg
        class='h-4 w-4 text-violet'
        viewBox='0 0 24 24'
        fill='currentColor'
        role='img'
        aria-label='love'
      >
        <path
          d='M12 21s-6.716-4.297-9.192-8.06C1.07 10.2 2.07 6.5 5.2 5.4 7.28 4.67 9.6 5.5 12 8.1c2.4-2.6 4.72-3.43 6.8-2.7 3.13 1.1 4.13 4.8 2.392 7.54C18.716 16.703 12 21 12 21Z'
        ></path>
      </svg>
    </p>

    <a
      href='#main'
      class='group inline-flex min-h-[40px] items-center gap-2 rounded-full border border-line px-4 font-mono text-xs uppercase tracking-[0.16em] transition-colors duration-100 ease-out hover:border-ink'
    >
      Back to top
      <svg
        class='h-3.5 w-3.5 transition-transform duration-150 ease-out group-hover:-translate-y-0.5'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='1.5'
        stroke-linecap='round'
        stroke-linejoin='round'
        aria-hidden='true'
      >
        <path d='M12 19V5M6 11l6-6 6 6'></path>
      </svg>
    </a>
  </div>
</footer>
