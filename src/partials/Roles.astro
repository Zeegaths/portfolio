---
import { currentRoles } from '@/utils/Content';
---

<section
  id='now'
  class='scroll-mt-24 border-y border-line bg-surface py-20 sm:py-28'
>
  <div class='container-page'>
    <div class='grid gap-12 lg:grid-cols-12 lg:gap-16'>
      <div class='reveal lg:col-span-5'>
        <p class='eyebrow'>
          <span
            class='inline-block h-1.5 w-1.5 rounded-full bg-violet motion-safe:animate-pulse'
            aria-hidden='true'></span>
          Currently
        </p>
        <h2
          class='text-balance mt-5 font-display text-3xl font-semibold tracking-tight sm:text-4xl'
          data-reveal-lines
        >
          Two sides of the same work.
        </h2>
        <p class='mt-4 max-w-prose text-ink-muted'>
          I build the products, and I help them land in African markets. Most
          weeks involve some of both.
        </p>
      </div>

      <dl class='reveal lg:col-span-7'>
        {currentRoles.map((role) => (
          <div class="grid gap-2 border-t border-line py-6 sm:grid-cols-5 sm:gap-6">
            <dt class="sm:col-span-2">
              <span class="block font-display text-base font-medium">
                {role.title}
              </span>
              {role.href ? (
                <a
                  href={role.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group mt-1 inline-flex min-h-[40px] items-center gap-1 font-mono text-xs uppercase tracking-[0.16em] text-ink-muted transition-colors duration-100 ease-out hover:text-violet"
                >
                  {role.org}
                  <span
                    class="transition-transform duration-150 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              ) : (
                <span class="mt-1 inline-flex min-h-[40px] items-center font-mono text-xs uppercase tracking-[0.16em] text-ink-muted">
                  {role.org}
                </span>
              )}
            </dt>

            <dd class="text-sm leading-relaxed text-ink-muted sm:col-span-3">
              {role.blurb}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
