---
import { projects } from '@/utils/Content';
---

<section id='work' class='scroll-mt-24 py-20 sm:py-28'>
  <div class='container-page'>
    <div class='reveal flex flex-wrap items-end justify-between gap-6'>
      <div class='max-w-2xl'>
        <p class='eyebrow'>
          <span
            class='inline-block h-1.5 w-1.5 rounded-full bg-violet motion-safe:animate-pulse'
            aria-hidden='true'></span>
          Selected work
        </p>
        <h2
          class='text-balance mt-5 font-display text-3xl font-semibold tracking-tight sm:text-4xl'
          data-reveal-lines
        >
          Couple of projects I've built.
        </h2>
      </div>
      <p class='font-mono text-xs uppercase tracking-[0.2em] text-ink-muted'>
        {String(projects.length).padStart(2, '0')} projects
      </p>
    </div>

    <div class='mt-16 flex flex-col gap-20 sm:gap-28'>
      {projects.map((project, index) => (
        <article class="reveal group">
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="grid items-center gap-8 rounded-3xl lg:grid-cols-12 lg:gap-14"
          >
            <div
              class={`overflow-hidden rounded-2xl border border-line bg-surface p-2 sm:p-3 lg:col-span-7 ${
                index % 2 === 1 ? 'lg:order-2' : ''
              }`}
            >
              <img
                src={project.img}
                alt={project.alt}
                width="1200"
                height="750"
                loading="lazy"
                class="aspect-[16/10] w-full rounded-xl bg-paper object-contain transition-transform duration-[400ms] ease-out motion-safe:group-hover:scale-[1.02]"
              />
            </div>

            <div class="lg:col-span-5">
              <div class="flex items-center gap-4">
                <span class="font-mono text-xs tracking-[0.2em] text-violet">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="h-px flex-1 bg-line" aria-hidden="true" />
                <span class="font-mono text-xs tracking-[0.2em] text-ink-muted">
                  {project.year}
                </span>
              </div>

              <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight transition-colors duration-100 ease-out group-hover:text-violet sm:text-3xl">
                {project.name}
              </h3>
              <p class="mt-1 font-mono text-xs uppercase tracking-[0.16em] text-ink-muted">
                {project.tagline}
              </p>

              {project.note && (
                <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-lime px-3 py-1 font-mono text-[11px] uppercase tracking-widest text-ink">
                  {project.note}
                </p>
              )}

              <p class="mt-5 max-w-prose leading-relaxed text-ink-muted">
                {project.description}
              </p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="rounded-full border border-line px-3 py-1 font-mono text-[11px] uppercase tracking-widest text-ink-muted">
                    {tag}
                  </li>
                ))}
              </ul>

              <span class="mt-8 inline-flex items-center gap-2 font-medium text-ink">
                Visit site
                <svg
                  class="h-4 w-4 transition-transform duration-150 ease-out motion-safe:group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
