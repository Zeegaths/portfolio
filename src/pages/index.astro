---
import CTA from '@/partials/CTA.astro';
import Gallery from '@/partials/Gallery.astro';
import Hero from '@/partials/Hero.astro';
import ProjectList from '@/partials/ProjectList.astro';
import RecentPosts from '@/partials/RecentPosts.astro';
import Roles from '@/partials/Roles.astro';
import Social from '@/partials/Social.astro';
import TechStack from '@/partials/TechStack.astro';
import Base from '@/templates/Base.astro';
import type { IFrontmatter } from '@/types/Frontmatter';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';

const allPosts = await Astro.glob<IFrontmatter>('./posts/*.md');
const sortedPosts = sortByDate(allPosts);
const lastThreePosts = sortedPosts.slice(0, 3);

const { title, description } = AppConfig;
---

<Base head={{ title, description }}>
  <Hero />
  <Roles />
  <ProjectList />
  <TechStack />
  <Social />
  <Gallery />
  <RecentPosts postList={lastThreePosts} />
  <CTA />
</Base>
