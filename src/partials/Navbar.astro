---
import { AppConfig } from '@/utils/AppConfig';

const links = [
  { label: 'Now', href: '/#now' },
  { label: 'Work', href: '/#work' },
  { label: 'Stack', href: '/#stack' },
  { label: 'Cool stuff', href: '/#cool-stuff' },
  { label: 'Writing', href: '/posts/' },
  { label: 'Elsewhere', href: '/#elsewhere' },
];
---

<header
  id='site-header'
  class='sticky top-0 z-40 border-b border-transparent bg-paper/80 backdrop-blur-md transition-colors duration-200 ease-out data-[scrolled]:border-line'
>
  <nav
    class='container-page flex h-16 items-center justify-between gap-4 sm:h-20'
  >
    <a
      href='/'
      class='group flex items-center gap-3 rounded-md'
      aria-label={`${AppConfig.author}, home`}
    >
      <!-- Portrait, desaturated to match the rest of the site and full
           colour on hover. Same framing as the hero circle. -->
      <span
        class='relative block h-9 w-9 shrink-0 overflow-hidden rounded-full border border-line bg-surface'
      >
        <img
          src='/assets/images/avatar-zarah.jpg'
          alt=''
          width='160'
          height='160'
          class='photo-muted h-full w-full object-cover transition-[filter] duration-200 ease-out'
        />
      </span>
      <span
        class='font-display text-base font-semibold tracking-tight sm:text-lg'
      >
        Mary Gathoni
      </span>
    </a>

    <div class='flex items-center gap-1 sm:gap-2'>
      <ul class='hidden items-center gap-1 md:flex'>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="group relative inline-flex min-h-[40px] items-center rounded-md px-3 text-sm font-medium text-ink-muted transition-colors duration-100 ease-out hover:text-ink"
            >
              {link.label}
              <span
                class="absolute inset-x-3 bottom-1.5 h-0.5 origin-left scale-x-0 bg-lime transition-transform duration-150 ease-out group-hover:scale-x-100"
                aria-hidden="true"
              />
            </a>
          </li>
        ))}
      </ul>

      <a
        href='#contact'
        class='inline-flex min-h-[40px] items-center gap-2 rounded-full bg-ink px-4 text-sm font-medium text-paper transition-colors duration-100 ease-out hover:bg-violet sm:px-5'
      >
        <span class='relative flex h-2 w-2' aria-hidden='true'>
          <span
            class='absolute inline-flex h-full w-full rounded-full bg-lime motion-safe:animate-pulse-ring'
          ></span>
          <span class='relative inline-flex h-2 w-2 rounded-full bg-lime'
          ></span>
        </span>
        Start a project
      </a>
    </div>
  </nav>

  <!-- Nav links live here on small screens instead of behind a hamburger. -->
  <div class='border-t border-line md:hidden'>
    <ul class='container-page flex items-center gap-1 overflow-x-auto py-1'>
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex min-h-[40px] items-center whitespace-nowrap rounded-md px-3 text-sm font-medium text-ink-muted transition-colors duration-100 ease-out hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  if (header) {
    const sync = () => {
      if (window.scrollY > 8) {
        header.setAttribute('data-scrolled', '');
      } else {
        header.removeAttribute('data-scrolled');
      }
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
