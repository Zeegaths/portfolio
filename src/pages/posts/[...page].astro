---
import BlogGallery from '@/partials/BlogGallery.astro';
import CTA from '@/partials/CTA.astro';
import Base from '@/templates/Base.astro';
import type { FrontmatterPage, IFrontmatter } from '@/types/Frontmatter';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';

type GetStaticPaths = {
  paginate: any;
};

export async function getStaticPaths({ paginate }: GetStaticPaths) {
  const allPosts = await Astro.glob<IFrontmatter>('./*.md');
  const sortedPosts = sortByDate(allPosts);

  return paginate(sortedPosts, { pageSize: 6 });
}

interface Props {
  page: FrontmatterPage;
}

const { page } = Astro.props as Props;
const title = `Writing, page ${page.currentPage} | ${AppConfig.site_name}`;
const description =
  'Articles on smart contracts, Solidity patterns and onboarding people to Web3.';
---

<Base head={{ title, description }}>
  <section class='container-page py-16 sm:py-24'>
    <div class='reveal max-w-2xl'>
      <p class='eyebrow'>
        <span
          class='inline-block h-1.5 w-1.5 rounded-full bg-violet motion-safe:animate-pulse'
          aria-hidden='true'></span>
        Writing
      </p>
      <h1
        class='text-balance mt-5 font-display text-4xl font-bold tracking-tight sm:text-5xl'
        data-reveal-lines
      >
        Things I've written.
      </h1>
      <p class='mt-4 max-w-prose text-ink-muted'>
        Solidity patterns, chain trade-offs and the occasional post-mortem. Most
        pieces run in full on Medium.
      </p>
    </div>

    <div class='mt-14'>
      <BlogGallery postList={page.data} />
    </div>

    {(page.url.prev || page.url.next) && (
      <nav
        class="mt-16 flex items-center justify-between gap-4 border-t border-line pt-8"
        aria-label="Pagination"
      >
        {page.url.prev ? (
          <a
            href={page.url.prev}
            class="group inline-flex min-h-[48px] items-center gap-2 rounded-full border border-line px-6 text-sm font-medium transition-colors duration-100 ease-out hover:border-ink"
          >
            <svg
              class="h-4 w-4 transition-transform duration-150 ease-out group-hover:-translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M11 18l-6-6 6-6" />
            </svg>
            Newer
          </a>
        ) : (
          <span />
        )}

        <p class="font-mono text-xs uppercase tracking-[0.16em] text-ink-muted">
          {page.currentPage} / {page.lastPage}
        </p>

        {page.url.next ? (
          <a
            href={page.url.next}
            class="group inline-flex min-h-[48px] items-center gap-2 rounded-full border border-line px-6 text-sm font-medium transition-colors duration-100 ease-out hover:border-ink"
          >
            Older
            <svg
              class="h-4 w-4 transition-transform duration-150 ease-out group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </section>

  <CTA />
</Base>
